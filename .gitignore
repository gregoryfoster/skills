# No trailing slash. A linked worktree inherits no virtualenv, so the pre-commit
# hook symlinks the main checkout's in on its own (#156) — nobody types the
# `ln -s` and nothing announces that .venv is now a symlink. `.venv/` matches
# only a real directory, so it would leave that symlink untracked-but-visible
# and one `git add -A` away from committing an absolute machine-local path.
.venv
__pycache__/
*.py[co]
.pytest_cache/
.coverage
htmlcov/
.env
env
tests/benchmarks/results/*.jsonl
.claude/worktrees/